@page
@model ConfirmEmailModel
@{
    ViewData["Title"] = "Compte confirmé";
}


<div class="min-h-screen flex items-center justify-center bg-soft px-4">

    <div class="max-w-md w-full bg-white p-8 rounded-2xl shadow-xl text-center space-y-6 border border-gray-100">

        <div class="flex justify-center">
            <div class="h-16 w-16 rounded-full bg-green-100 flex items-center justify-center shadow-inner">
                <svg class="h-8 w-8 text-green-600"
                     fill="none"
                     stroke="currentColor"
                     viewBox="0 0 24 24">
                    <path stroke-linecap="round"
                          stroke-linejoin="round"
                          stroke-width="2"
                          d="M5 13l4 4L19 7" />
                </svg>
            </div>
        </div>

        <div>
            <h1 class="text-2xl font-bold text-primary">
                Compte activé avec succès
            </h1>

            <p class="text-sm text-gray-500 mt-1">
                Votre adresse email a été confirmée.
            </p>
        </div>

        <div class="bg-green-50 border border-green-200 text-green-800 text-sm rounded-lg p-4 space-y-2">

            <p>
                Votre espace sécurisé est maintenant actif.
            </p>

            <p class="text-xs text-green-700">
                Vous pouvez certifier, vérifier et horodater vos documents numériques en toute confiance.
            </p>

        </div>

        <div class="pt-4 border-t border-gray-100">

            <a asp-area="Identity"
               asp-page="/Account/Login"
               class="inline-flex items-center justify-center gap-2
                      bg-primary text-white px-5 py-2.5 rounded-lg
                      hover:bg-primary/90 transition font-medium shadow">

                Accéder à mon espace

                <svg class="w-4 h-4"
                     fill="none"
                     stroke="currentColor"
                     viewBox="0 0 24 24">
                    <path stroke-linecap="round"
                          stroke-linejoin="round"
                          stroke-width="2"
                          d="M14 5l7 7m0 0l-7 7m7-7H3" />
                </svg>
            </a>

        </div>

        <div class="pt-2 text-xs text-gray-400">
            Activation sécurisée — PreuveTierce
        </div>

    </div>
</div>
