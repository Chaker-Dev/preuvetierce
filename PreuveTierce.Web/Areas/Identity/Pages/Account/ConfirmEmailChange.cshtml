@page
@model ConfirmEmailChangeModel
@{
    ViewData["Title"] = "Confirmation du changement d’email";
}
  <div class="min-h-screen flex items-start justify-center mt-10">
     <div class="w-full max-w-md bg-white p-8 text-center space-y-6">

        @if (Model.IsSuccess)
        {
            <div class="flex justify-center">
                <div class="h-16 w-16 rounded-full bg-green-100 flex items-center justify-center">
                    <svg class="h-8 w-8 text-green-600"
                         fill="none"
                         stroke="currentColor"
                         viewBox="0 0 24 24">
                        <path stroke-linecap="round"
                              stroke-linejoin="round"
                              stroke-width="2"
                              d="M5 13l4 4L19 7" />
                    </svg>
                </div>
            </div>

            <h1 class="text-2xl font-bold text-primary">
                Email mis à jour
            </h1>

            <p class="text-sm text-gray-600">
                @Model.StatusMessage
            </p>

            <a asp-area="" asp-controller="Home" asp-action="Index"
               class="inline-block bg-primary text-white px-5 py-2.5 rounded-lg hover:bg-primary/90 transition">
                Retour à l’accueil
            </a>
        }
        else
        {
            <div class="flex justify-center">
                <div class="h-16 w-16 rounded-full bg-red-100 flex items-center justify-center">
                    <svg class="h-8 w-8 text-red-600"
                         fill="none"
                         stroke="currentColor"
                         viewBox="0 0 24 24">
                        <path stroke-linecap="round"
                              stroke-linejoin="round"
                              stroke-width="2"
                              d="M6 18L18 6M6 6l12 12" />
                    </svg>
                </div>
            </div>

            <h1 class="text-2xl font-bold text-red-600">
                Action impossible
            </h1>

            <p class="text-sm text-gray-600">
                @Model.StatusMessage
            </p>

            <a asp-page="/Account/Manage/Email"
               class="inline-block bg-primary text-white px-5 py-2.5 rounded-lg hover:bg-primary/90 transition">
                Demander un nouveau lien
            </a>
        }

        <div class="pt-4 border-t text-xs text-gray-400">
            PreuveTierce — Sécurité & Confiance numérique
        </div>

    </div>
</div>