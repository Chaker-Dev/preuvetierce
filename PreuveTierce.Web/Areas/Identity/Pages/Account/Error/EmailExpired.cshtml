@page
@model PreuveTierce.Web.Areas.Identity.Pages.Account.Error.EmailExpiredModel
@{
    ViewData["Title"] = "Lien expiré";
}
<div class="min-h-screen flex items-center justify-center bg-soft px-4">

    <div class="max-w-md w-full bg-white p-8 rounded-2xl shadow-xl text-center space-y-6 border">

        <div class="flex justify-center">
            <div class="h-16 w-16 rounded-full bg-yellow-100 flex items-center justify-center">
                ⏳
            </div>
        </div>

        <h1 class="text-xl font-bold text-gray-900">
            Lien de confirmation expiré
        </h1>

        <p class="text-sm text-gray-600">
            Pour des raisons de sécurité, ce lien n’est plus valide.
        </p>
        <form method="post">
            <input type="hidden" asp-for="UserId" />

            <button type="submit"
                    class="cursor-pointer w-full bg-primary text-white py-2.5 rounded-lg font-medium hover:bg-primary/90 transition">
                Renvoyer un email de confirmation
            </button>
        </form>

        <p class="text-xs text-gray-400">
            Un nouveau lien vous sera envoyé immédiatement.
        </p>

    </div>
</div>