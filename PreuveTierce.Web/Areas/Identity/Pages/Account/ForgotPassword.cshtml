@page
@model ForgotPasswordModel
@{
    ViewData["Title"] = "Mot de passe oublié ?";
}

<div class="min-h-screen flex items-start justify-center mt-10">

    <div class="w-full max-w-md bg-white shadow-lg rounded-xl p-8 text-center">
    <div class="flex items-center gap-3 mb-6">
        <div class="bg-indigo-100 text-indigo-600 p-3 rounded-full">
            <i class="bi bi-shield-lock text-xl"></i>
        </div>
        <h2 class="text-xl font-semibold text-gray-800">
            @ViewData["Title"]
        </h2>
    </div>

    <p class="text-gray-600 mb-6">
        Pas d'inquiétude ! Entrez l'adresse email associée à votre compte et nous vous enverrons un lien pour réinitialiser votre mot de passe.
    </p>

    <form method="post" class="space-y-5">
        <div>
            <label asp-for="Input.Email" class="block text-sm font-medium text-gray-700 mb-1 text-left">
                Adresse email
            </label>
            <input asp-for="Input.Email"
                   class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:outline-none transition"
                   placeholder="nom@exemple.com"
                   aria-required="true" />
                <span asp-validation-for="Input.Email" class="text-sm text-red-500 text-left"></span>
        </div>

        <button type="submit"
                    class="w-full bg-primary cursor-pointer hover:bg-blue-700 text-white py-2 rounded font-medium shadow-sm transition-all transform hover:-translate-y-0.5">
            Envoyer le lien de réinitialisation
        </button>

        <div class="text-center">
            <a asp-page="./Login" class="text-sm text-gray-500 hover:text-indigo-600 hover:underline">
                <i class="bi bi-arrow-left"></i> Retour à la connexion
            </a>
        </div>
    </form>
</div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}