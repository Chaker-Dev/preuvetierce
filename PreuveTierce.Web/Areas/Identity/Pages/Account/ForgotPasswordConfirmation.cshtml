@page
@model ForgotPasswordConfirmation
@{
    ViewData["Title"] = "Email envoyé";
}
<div class="min-h-screen flex items-start justify-center mt-10">

<div class="w-full max-w-md bg-white shadow-lg rounded-xl p-8 text-center">

    <div class="inline-flex items-center justify-center bg-green-100 text-green-600 p-4 rounded-full mb-6">
        <i class="bi bi-send-check text-3xl"></i>
    </div>

    <h2 class="text-2xl font-bold text-gray-800 mb-4">
        Vérifiez votre boîte mail
    </h2>

    <p class="text-gray-600 mb-8 leading-relaxed">
        Si un compte correspond à l'adresse indiquée, vous recevrez un lien pour réinitialiser votre mot de passe dans quelques instants.
    </p>

    <div class="bg-blue-50 rounded-xl p-4 mb-6 text-sm text-blue-800 text-left">
        <div class="flex gap-3">
            <i class="bi bi-info-circle-fill text-blue-500"></i>
            <div>
                <strong>Vous ne trouvez pas l'email ?</strong>
                <ul class="list-disc ml-4 mt-1 space-y-1">
                    <li>Vérifiez votre dossier "Courriers indésirables" (Spam).</li>
                    <li>Attendez quelques minutes.</li>
                    <li>Assurez-vous d'avoir saisi la bonne adresse email.</li>
                </ul>
            </div>
        </div>
    </div>

    <div class="space-y-3">
        <a asp-page="./Login" class="block w-full bg-blue-600 hover:bg-blue-700 text-white py-2.5 rounded-lg font-medium transition shadow-sm">
            Retour à la connexion
        </a>
        <a href="/" class="block text-sm text-gray-500 hover:text-gray-700 hover:underline">
            Retour à l'accueil
        </a>
    </div>
</div>  
</div>