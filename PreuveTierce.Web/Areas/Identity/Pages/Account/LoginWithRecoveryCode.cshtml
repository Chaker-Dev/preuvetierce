@page
@model LoginWithRecoveryCodeModel
@{
    ViewData["Title"] = "Connexion avec code de secours";
}

<div class="max-w-md mx-auto mt-12 bg-white shadow-xl rounded-2xl p-8 border border-gray-100 mx-5 mt-4">

    <div class="text-center mb-8">
        <div class="inline-flex items-center justify-center bg-orange-100 text-orange-600 p-4 rounded-full mb-4">
            <i class="bi bi-lifebuoy text-3xl"></i>
        </div>
        <h1 class="text-2xl font-bold text-gray-800">Code de secours</h1>
        <p class="text-gray-500 mt-2 text-sm leading-relaxed">
            Vous avez demandé à vous connecter avec un code de secours.
            <span class="block font-medium text-orange-700 mt-1">Attention : cette connexion ne sera pas mémorisée par le navigateur.</span>
        </p>
    </div>

    <form method="post" class="space-y-6">
        <div asp-validation-summary="ModelOnly" class="text-sm text-red-500 text-center" role="alert"></div>

        <div>
            <label asp-for="Input.RecoveryCode" class="block text-sm font-semibold text-gray-700 mt-10 mb-2">
                Saisissez votre code de secours
            </label>
            <input asp-for="Input.RecoveryCode"
                   class="w-full px-4 py-3 border border-gray-300 rounded-xl text-center text-lg font-mono uppercase tracking-widest focus:ring-2 focus:ring-orange-500 focus:border-orange-500 outline-none transition"
                   autocomplete="off"
                   placeholder="XXXXX-XXXXX" />
            <span asp-validation-for="Input.RecoveryCode" class="text-xs text-red-500 mt-1 block"></span>
        </div>

        <button type="submit"
                class="cursor-pointer w-full bg-primary text-white py-2.5 rounded-md font-medium shadow-sm hover:bg-opacity-90">
            Valider et se connecter
        </button>
    </form>

    <div class="mt-10 pt-6 border-t text-center">
        <a asp-page="./Login" class="text-sm text-gray-500 hover:text-blue-600 transition">
            <i class="bi bi-arrow-left"></i> Retour à la connexion classique
        </a>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}