@page
@model ChangePasswordModel
@{
    Layout = "_ManageLayout";
    ViewData["Title"] = "Changer le mot de passe";
    ViewData["ActivePage"] = ManageNavPages.ChangePassword;
}

<h1 class="text-xl font-semibold text-primary mb-6">
            Modifier le mot de passe
 </h1>

 <partial name="_StatusMessage" for="StatusMessage" />

<form method="post" class="space-y-5 max-w-md">
            <div asp-validation-summary="ModelOnly" class="text-error text-sm"></div>

            <!-- Ancien mot de passe -->
            <div>
                <label asp-for="Input.OldPassword" class="block text-sm font-medium text-gray-700">
                    Mot de passe actuel
                </label>
                <input asp-for="Input.OldPassword"
                       class="mt-1 w-full rounded border border-gray-300 px-3 py-2 focus:border-primary focus:ring focus:ring-primary/30"
                       placeholder="••••••••" />
                <span asp-validation-for="Input.OldPassword" class="text-error text-sm"></span>
            </div>

            <!-- Nouveau mot de passe -->
            <div>
                <label asp-for="Input.NewPassword" class="block text-sm font-medium text-gray-700">
                    Nouveau mot de passe
                </label>
                <input asp-for="Input.NewPassword"
                       class="mt-1 w-full rounded border border-gray-300 px-3 py-2 focus:border-primary focus:ring focus:ring-primary/30"
                       placeholder="••••••••" />
                <span asp-validation-for="Input.NewPassword" class="text-error text-sm"></span>
            </div>

            <!-- Confirmation -->
            <div>
                <label asp-for="Input.ConfirmPassword" class="block text-sm font-medium text-gray-700">
                    Confirmer le nouveau mot de passe
                </label>
                <input asp-for="Input.ConfirmPassword"
                       class="mt-1 w-full rounded border border-gray-300 px-3 py-2 focus:border-primary focus:ring focus:ring-primary/30"
                       placeholder="••••••••" />
                <span asp-validation-for="Input.ConfirmPassword" class="text-error text-sm"></span>
            </div>

            <button type="submit"
                    class="w-full bg-primary text-white py-2 rounded font-medium hover:bg-primary/90 transition">
                Mettre à jour
            </button>
        </form>
