@page
@model DeletePersonalDataModel
@{
    ViewData["Title"] = "Supprimer mes données";
    ViewData["ActivePage"] = ManageNavPages.PersonalData;
}

<section class="space-y-6">

    <div class="flex items-center gap-3 mb-6">
        <div class="bg-red-100 text-red-600 p-3 rounded-full">
            <i class="bi bi-exclamation-triangle text-xl"></i>
        </div>
        <h2 class="text-xl font-semibold text-red-600">
            Suppression du compte
        </h2>
    </div>

    <p class="text-gray-600 mb-6">
        Cette action est <span class="font-semibold text-red-600">définitive</span>.
        Toutes vos données seront supprimées et ne pourront pas être récupérées.
    </p>

    <form method="post" class="space-y-4">

        <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">
                Confirmez votre mot de passe
            </label>
            <input asp-for="Input.Password"
                   type="password"
                   class="w-full px-4 py-2 border rounded focus:ring-2 focus:ring-red-500 focus:outline-none" />
            <span asp-validation-for="Input.Password"
                  class="text-sm text-red-500"></span>
        </div>

        <button type="submit"
                class="w-full bg-red-600 hover:bg-red-700 text-white py-2 rounded cursor-pointer font-medium transition">
            Supprimer définitivement mon compte
        </button>

        <a asp-page="./PersonalData"
           class="block text-center text-sm text-gray-500 hover:underline">
            Annuler
        </a>

    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}