@page
@model IndexModel
@{
    Layout = "_ManageLayout";
    ViewData["Title"] = "Mon profil";
    ViewData["ActivePage"] = ManageNavPages.Index;
}

<h1 class="text-xl font-semibold text-primary mb-6">
    Informations du compte
</h1>

<partial name="_StatusMessage" for="StatusMessage" />

<form method="post" class="space-y-5 max-w-md">

    <div>
        <label class="block text-sm font-medium text-gray-700">
            Nom d’utilisateur
        </label>
        <input asp-for="Username" disabled
               class="mt-1 w-full rounded border border-gray-300 bg-gray-100 px-3 py-2" />
    </div>

    <div>
        <label asp-for="Input.PhoneNumber" class="block text-sm font-medium text-gray-700">
            Numéro de téléphone
        </label>
        <input asp-for="Input.PhoneNumber"
               class="mt-1 w-full rounded border border-gray-300 px-3 py-2
                      focus:border-primary focus:ring focus:ring-primary/30" />
        <span asp-validation-for="Input.PhoneNumber" class="text-error text-sm"></span>
    </div>

    <button type="submit"
            class="cursor-pointer bg-primary text-white px-6 py-2 rounded font-medium
                   hover:bg-primary/90 transition">
        Enregistrer
    </button>
</form>