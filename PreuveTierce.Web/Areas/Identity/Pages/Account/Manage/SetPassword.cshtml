@page
@model SetPasswordModel
@{
    Layout = "_ManageLayout";
    ViewData["Title"] = "Définir un mot de passe";
    ViewData["ActivePage"] = ManageNavPages.ChangePassword;
}

<div class="grid grid-cols-1 md:grid-cols-4 gap-6">

    <aside class="md:col-span-1 bg-white p-4 rounded-lg card-shadow">
        <partial name="_ManageNav" />
    </aside>

    <section class="md:col-span-3 bg-white p-6 rounded-lg card-shadow space-y-6">
        <h1 class="text-xl font-semibold text-primary">
            Définir un mot de passe
        </h1>

        <p class="text-gray-600 text-sm">
            Votre compte utilise actuellement une connexion externe.
            Définissez un mot de passe pour vous connecter directement.
        </p>

        <partial name="_StatusMessage" for="StatusMessage" />

        <form method="post" class="space-y-4 max-w-md">
            <div>
                <label asp-for="Input.NewPassword" class="block text-sm font-medium text-gray-700">
                    Nouveau mot de passe
                </label>
                <input asp-for="Input.NewPassword"
                       class="mt-1 w-full rounded border border-gray-300 px-3 py-2 focus:border-primary focus:ring focus:ring-primary/30" />
                <span asp-validation-for="Input.NewPassword" class="text-error text-sm"></span>
            </div>

            <div>
                <label asp-for="Input.ConfirmPassword" class="block text-sm font-medium text-gray-700">
                    Confirmer le mot de passe
                </label>
                <input asp-for="Input.ConfirmPassword"
                       class="mt-1 w-full rounded border border-gray-300 px-3 py-2 focus:border-primary focus:ring focus:ring-primary/30" />
                <span asp-validation-for="Input.ConfirmPassword" class="text-error text-sm"></span>
            </div>

            <button type="submit"
                    class="bg-primary text-white px-6 py-2 rounded font-medium hover:bg-primary/90 transition">
                Définir le mot de passe
            </button>
        </form>
    </section>
</div>
