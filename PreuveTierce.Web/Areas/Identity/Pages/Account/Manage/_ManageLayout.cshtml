@{
    Layout = "/Views/Shared/_Layout.cshtml";
}

<div class="max-w-6xl mx-auto px-4 py-10 h-full">

    <div class="grid grid-cols-1 md:grid-cols-4 gap-6 flex-1">

        <!-- MENU -->
        <aside class="md:col-span-1 bg-white p-6 rounded-lg card-shadow">
            <partial name="_ManageNav" />
        </aside>

        <!-- CONTENU -->
        <section class="md:col-span-3 bg-white p-8 rounded-lg card-shadow flex-1">
            @RenderBody()
        </section>

    </div>

</div>

@RenderSection("Scripts", required: false)
