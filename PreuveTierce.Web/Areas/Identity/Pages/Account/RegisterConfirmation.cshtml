@page
@model RegisterConfirmationModel
@{
    ViewData["Title"] = "Confirmation d’inscription";
}

<div class="min-h-screen flex items-start justify-center mt-10">

    <div class="max-w-md w-full bg-white p-8 rounded-2xl shadow-xl text-center space-y-6 border border-gray-100">

        <div class="flex justify-center">
            <div class="h-16 w-16 rounded-full bg-green-100 flex items-center justify-center shadow-inner">
                <svg class="h-8 w-8 text-green-600"
                     fill="none"
                     stroke="currentColor"
                     viewBox="0 0 24 24">
                    <path stroke-linecap="round"
                          stroke-linejoin="round"
                          stroke-width="2"
                          d="M5 13l4 4L19 7" />
                </svg>
            </div>
        </div>

        <div>
            <h1 class="text-2xl font-bold text-primary">
                Compte créé avec succès
            </h1>

            <p class="text-sm text-gray-500 mt-1">
                Activez votre compte pour accéder à votre espace sécurisé.
            </p>
        </div>

        <div class="space-y-4">

            <p class="text-gray-700 text-sm">
                Un email de confirmation a été envoyé à :
            </p>

            <p class="font-semibold text-gray-900 text-sm break-all">
                @Model.Email
            </p>

            <div class="bg-blue-50 border border-blue-200 text-blue-800 text-sm rounded p-4">
                Cliquez sur le bouton <strong>“Confirmer mon compte”</strong> contenu dans l’email pour finaliser l’activation.
            </div>

            <p class="text-xs text-gray-500">
                Si vous ne trouvez pas l’email, vérifiez votre dossier
                <strong>Spam</strong> ou <strong>Indésirable</strong>.
            </p>

        </div>

        <div class="pt-4 border-t border-gray-100">

            <a asp-page="./Login"
               class="inline-flex items-center justify-center gap-2
                      bg-primary text-white px-5 py-2.5 rounded-lg
                      hover:bg-primary/90 transition font-medium shadow">

                Accéder à la connexion

                <svg class="w-4 h-4"
                     fill="none"
                     stroke="currentColor"
                     viewBox="0 0 24 24">
                    <path stroke-linecap="round"
                          stroke-linejoin="round"
                          stroke-width="2"
                          d="M14 5l7 7m0 0l-7 7m7-7H3" />
                </svg>
            </a>

        </div>

        <div class="pt-2 text-xs text-gray-400">
            PreuveTierce — Tiers de confiance numérique
        </div>

    </div>
</div>
