@page
@model ResendEmailConfirmation
@{
    ViewData["Title"] = "Renvoyer l'email de confirmation";
}

<div class="min-h-screen flex items-start justify-center mt-10">

    <div class="w-full max-w-md bg-white shadow-lg rounded-xl p-8 text-center">
    <div class="flex items-center gap-3 mb-6">
        <div class="bg-blue-100 text-blue-600 p-3 rounded-full">
            <i class="bi bi-envelope-paper-fill text-xl"></i>
        </div>
        <h2 class="text-xl font-semibold text-gray-800">
            @ViewData["Title"]
        </h2>
    </div>

    <p class="text-gray-600 mb-6">
        Vous n'avez pas reçu l'email ? Entrez votre adresse ci-dessous pour recevoir un nouveau lien d'activation.
    </p>

    <form method="post" class="space-y-5">
        <div>
            <label asp-for="Input.Email" class="block text-sm font-medium text-gray-700 mb-1 text-left">
                Votre adresse email
            </label>
            <input asp-for="Input.Email"
                   class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:outline-none transition"
                   placeholder="nom@exemple.com"
                   aria-required="true" />
            <span asp-validation-for="Input.Email" class="text-sm text-red-500"></span>
        </div>

        <button type="submit"
                    class="w-full bg-primary hover:bg-blue-600 text-white py-2 rounded font-medium shadow-sm transition-all transform hover:-translate-y-0.5 cursor-pointer">
            Renvoyer l'email d'activation
        </button>

        <div class="text-center">
            <a asp-page="./Login" class="text-sm text-blue-600 hover:underline">
                Retour à la page de connexion
            </a>
        </div>
    </form>
</div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}