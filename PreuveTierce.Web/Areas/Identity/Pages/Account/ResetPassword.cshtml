@page
@model ResetPasswordModel
@{
    ViewData["Title"] = "Réinitialisation du mot de passe";
}

<div class="min-h-screen flex items-start justify-center mt-10">
    <div class="max-w-md w-full bg-white p-8 rounded-lg card-shadow space-y-6">

        <div class="text-center">
            <h1 class="text-2xl font-semibold text-primary">
                Réinitialiser le mot de passe
            </h1>
            <p class="text-gray-600 text-sm mt-2">
                Choisissez un nouveau mot de passe sécurisé
            </p>
        </div>

        <form method="post" class="space-y-4">
            <div asp-validation-summary="ModelOnly" class="text-error text-sm"></div>

            <input asp-for="Input.Code" type="hidden" />

            <!-- Email -->
            <div>
                <label asp-for="Input.Email" class="block text-sm font-medium text-gray-700">
                    Adresse email
                </label>
                <input asp-for="Input.Email"
                       class="mt-1 w-full rounded border border-gray-300 px-3 py-2 focus:border-primary focus:ring focus:ring-primary/30"
                       placeholder="email@exemple.com" />
                <span asp-validation-for="Input.Email" class="text-error text-sm"></span>
            </div>

            <!-- Nouveau mot de passe -->
            <div>
                <label asp-for="Input.Password" class="block text-sm font-medium text-gray-700">
                    Nouveau mot de passe
                </label>
                <input asp-for="Input.Password"
                       class="mt-1 w-full rounded border border-gray-300 px-3 py-2 focus:border-primary focus:ring focus:ring-primary/30"
                       placeholder="••••••••" />
                <span asp-validation-for="Input.Password" class="text-error text-sm"></span>
            </div>

            <!-- Confirmation -->
            <div>
                <label asp-for="Input.ConfirmPassword" class="block text-sm font-medium text-gray-700">
                    Confirmer le mot de passe
                </label>
                <input asp-for="Input.ConfirmPassword"
                       class="mt-1 w-full rounded border border-gray-300 px-3 py-2 focus:border-primary focus:ring focus:ring-primary/30"
                       placeholder="••••••••" />
                <span asp-validation-for="Input.ConfirmPassword" class="text-error text-sm"></span>
            </div>

            <button type="submit"
                    class="cursor-pointer w-full bg-primary text-white py-2 rounded font-medium hover:bg-primary/90 transition">
                Réinitialiser
            </button>
        </form>
    </div>
</div>
