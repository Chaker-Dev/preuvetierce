@page
@model ResetPasswordConfirmationModel
@{
    ViewData["Title"] = "Réinitialisation confirmée";
}

<div class="min-h-screen flex items-start justify-center mt-10">

    <div class="w-full max-w-md bg-white shadow-lg rounded-xl p-8 text-center">
    <div class="inline-flex items-center justify-center bg-green-100 text-green-600 p-4 rounded-full mb-6">
        <i class="bi bi-check2-circle text-4xl"></i>
    </div>

    <h2 class="text-2xl font-bold text-gray-800 mb-4">
        Mot de passe mis à jour !
    </h2>

    <p class="text-gray-600 mb-8 leading-relaxed">
        Votre nouveau mot de passe a été enregistré avec succès. Vous pouvez maintenant l'utiliser pour accéder à votre espace <strong>PreuveTierce</strong>.
    </p>

    <div class="space-y-4">
        <a asp-page="./Login" class="block w-full bg-indigo-600 hover:bg-indigo-700 text-white py-3 rounded-lg font-medium transition shadow-md transform hover:-translate-y-0.5">
            Se connecter maintenant
        </a>

        <p class="text-sm text-gray-500 pt-4 border-top">
            Besoin d'aide ? <a href="/Contact" class="text-indigo-600 hover:underline">Contactez le support</a>
        </p>
    </div>
</div>
</div>