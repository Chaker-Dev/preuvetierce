@using PreuveTierce.Web.ViewModels
@model List<CertifiedDocument>
@if (Model != null && Model.Count > 0){
<div class="bg-white rounded-lg card-shadow p-6 space-y-4">

    <div class="flex justify-between items-center">
        <div class="flex flex-col justify-center">
            <h2 class="text-2xl font-bold text-gray-900">Historique des certifications</h2>
            <p class="text-sm text-gray-500 mt-1">Consultez et gérez vos preuves d'intégrité.</p>
        </div>
            <input id="searchInput" type="text" placeholder="Rechercher (Nom, Ref...)"
                   class="px-3 py-2 border border-gray-200 rounded-lg text-sm focus:outline-none mx-5 focus:ring-2 focus:ring-[#000091] focus:border-transparent shadow-sm w-64 transition-all">

      
    </div>

    <div class="overflow-x-auto">
        <table class="w-full bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden" id="historyTable">
            <thead class="bg-gray-50 border-b-2 border-gray-500">
                <tr style="border-bottom: 2px solid gray">
                    <th scope="col" class="py-2 text-left font-semibold text-gray-500 uppercase tracking-wider">Document / Référence</th>
                    <th scope="col" class="py-2 text-left font-semibold text-gray-500 uppercase tracking-wider">Empreinte SHA-256</th>
                    <th scope="col" class="py-2 text-left font-semibold text-gray-500 uppercase tracking-wider">Date (UTC)</th>
                    <th scope="col" class="py-2 text-left font-semibold text-gray-500 uppercase tracking-wider">Statut</th>
                    <th scope="col" class="py-2 text-left font-semibold text-gray-500 uppercase tracking-wider">Actions</th>
                </tr>
            </thead>

            <tbody id="tableBody" class="bg-white divide-y divide-gray-100">
                    @foreach (var item in Model)
                    {
                        <tr class="hover:bg-[#f5f5fe] transition duration-150 ease-in-out group">
                            <td class="py-4 whitespace-nowrap">
                                <div class="flex items-center">
                                    <div class="flex-shrink-0 h-10 w-10 bg-red-50 text-red-500 rounded-lg flex items-center justify-center">
                                        <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M4 4a2 2 0 012-2h4.586A2 2 0 0112 2.586L15.414 6A2 2 0 0116 7.414V16a2 2 0 01-2 2H6a2 2 0 01-2-2V4z" clip-rule="evenodd"></path></svg>
                                    </div>
                                    <div class="ml-4">
                                        <div class="text-sm font-bold text-gray-900"> @item.FileName</div>
                                        <div class="text-xs text-gray-500 mt-0.5">Ref: @item.Reference</div>
                                    </div>
                                </div>
                            </td>
                            <td class="py-4 whitespace-nowrap">
                                @{
                                    var fullHash = item.Hash;
                                    var shortHash = fullHash.Length > 12
                                    ? $"{fullHash.Substring(0, 8)}...{fullHash.Substring(fullHash.Length - 4)}"
                                    : fullHash;
                                }
                                <div class="flex items-center space-x-2 group/hash cursor-pointer"
                                     onclick="copyHash(this, '@fullHash')"
                                     title="@fullHash"
                                     >
                                    <span class="px-2 py-1 rounded bg-gray-100 text-gray-600 font-mono
                                         group-hover/hash:border-[#000091]
                                         group-hover/hash:text-[#000091]
                                         transition">
                                        @shortHash
                                    </span>

                                    <svg class="w-4 h-4 text-gray-300 group-hover/hash:text-[#000091] transition"
                                         fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                              d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
                                    </svg>

                                </div>
                            </td>

                            <td class="py-4 whitespace-nowrap text-sm text-gray-500">
                                @item.CertifiedAt.ToString("dd/MM/yyyy")<br>
                                <span class="text-xs text-gray-400">@item.CertifiedAt.ToString("HH:mm") UTC</span>
                            </td>
                            <td class="py-4 whitespace-nowrap">
                                @{
                                    string statusLabel = item.Status?.ToLower() switch
                                    {
                                        "certificated" => "CERTIFIÉ",
                                        "certified" => "CERTIFIÉ",
                                        _ => item.Status?.ToUpper() ?? "-"
                                    };
                                }
                            <span class="px-3 py-1 inline-flex text-xs leading-5 font-semibold rounded-full
                                      bg-green-100 text-green-800 border border-green-200">
                                @statusLabel
                            </span>
                            </td>
                            <td class="py-4 whitespace-nowrap">
                                <a asp-controller="Dashboard"
                                   asp-action="DownloadPdf"
                                   asp-route-hash="@item.Hash"
                                   class="flex items-center gap-1 text-primary font-semibold
                      hover:text-[#000074] transition gap-1">

                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                              d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                                    </svg>

                                    <span class="text-sm">
                                        PDF
                                    </span>
                                </a>
                            </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Pagination -->
    @if (Model != null && Model.Count > 5)
    {
        <div  class="bg-gray-50 px-6 py-3 flex items-center justify-between">
            <span id="pageInfo" class="text-sm text-gray-600"></span>
        <div class="flex gap-3 space-x-2">
                <button id="prevPage" class="cursor-pointer px-3 py-1 border border-gray-300 rounded-md text-xs font-medium text-gray-500 bg-white hover:bg-gray-50 disabled:opacity-50">Précédent</button>
                <button id="nextPage" class="cursor-pointer px-3 py-1 border border-gray-300 rounded-md text-xs font-medium text-primary bg-white hover:bg-gray-50">Suivant</button>
        </div>
    </div>
    }
</div>
}