@{
    ViewData["Title"] = "Home Page";
}

<main id="main-content" class="flex-grow">

    <section id="view-home" class="py-12 px-4 sm:px-6 lg:px-8 max-w-4xl mx-auto">
        <div class="text-center mb-10">
            <h1 class="text-4xl font-extrabold text-primary mb-2">Sécurisez vos documents</h1>
            <p class="text-lg text-gray-600">Le tiers de confiance technique pour l'intégrité numérique.</p>
        </div>

        <div class="bg-white rounded-xl card-shadow overflow-hidden">
            <div class="bg-soft p-4 border-b border-gray-100 flex justify-between items-center">
                <span class="font-bold text-primary flex items-center">
                    <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                    Vérificateur d'intégrité
                </span>
                <span class="text-xs text-gray-500 bg-white px-2 py-1 rounded border">Aucun fichier stocké</span>
            </div>

            <div class="p-10">
                <div class="border-2 border-dashed border-primary border-opacity-30 rounded-lg p-12 text-center hover:bg-soft transition cursor-pointer group">
                    <div class="mb-4">
                        <svg class="mx-auto h-12 w-12 text-gray-400 group-hover:text-primary transition" stroke="currentColor" fill="none" viewBox="0 0 48 48">
                            <path d="M28 8H12a4 4 0 00-4 4v20m32-12v8m0 0v8a4 4 0 01-4 4H12a4 4 0 01-4-4v-4m32-4l-3.172-3.172a4 4 0 00-5.656 0L28 28M8 32l9.172-9.172a4 4 0 015.656 0L28 28m0 0l4 4m4-24h8m-4-4v8m-12 4h.02" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                        </svg>
                    </div>
                    <p class="text-sm text-gray-600">
                        <span class="font-medium text-primary">Cliquez pour uploader</span> ou glissez-déposez
                    </p>
                    <p class="text-xs text-gray-500 mt-1">PDF, DOCX, PNG, JPG (SHA-256 Hash local)</p>
                </div>
            </div>
        </div>

        <div class="mt-6 bg-green-50 border border-green-200 rounded-lg p-4 flex items-start">
            <svg class="h-6 w-6 text-green-600 mr-3 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
            <div>
                <h3 class="text-sm font-medium text-green-800">Document Certifié Authentique</h3>
                <p class="text-sm text-green-700 mt-1">Horodaté le: 25 Déc 2025 à 14:30:05 UTC</p>
                <p class="text-xs text-gray-500 mt-2 font-mono">Hash: e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855</p>
            </div>
        </div>
    </section>


    <section id="view-dashboard" class="hidden py-8 px-4 sm:px-6 lg:px-8 max-w-6xl mx-auto">

        <div class="flex justify-between items-center mb-8">
            <div>
                <h2 class="text-2xl font-bold text-gray-900">Mes Documents</h2>
                <p class="text-sm text-gray-500">Gérez vos preuves et téléchargez vos certificats.</p>
            </div>
            <button class="bg-primary text-white px-5 py-2.5 rounded shadow hover-lift flex items-center">
                <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
                Nouvelle Certification
            </button>
        </div>

        <div class="bg-white rounded-lg shadow overflow-hidden border border-gray-200">
            <table class="min-w-full divide-y divide-gray-200">
                <thead class="bg-soft">
                    <tr>
                        <th class="px-6 py-3 text-left text-xs font-bold text-gray-500 uppercase tracking-wider">Nom du Fichier</th>
                        <th class="px-6 py-3 text-left text-xs font-bold text-gray-500 uppercase tracking-wider">Date (UTC)</th>
                        <th class="px-6 py-3 text-left text-xs font-bold text-gray-500 uppercase tracking-wider">Statut</th>
                        <th class="px-6 py-3 text-right text-xs font-bold text-gray-500 uppercase tracking-wider">Actions</th>
                    </tr>
                </thead>
                <tbody class="bg-white divide-y divide-gray-200">
                    <tr class="hover:bg-gray-50 transition">
                        <td class="px-6 py-4 whitespace-nowrap">
                            <div class="flex items-center">
                                <svg class="flex-shrink-0 h-6 w-6 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
                                <span class="ml-4 text-sm font-medium text-gray-900">contrat_client_vfinal.pdf</span>
                            </div>
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">24 Déc 2025, 10:45</td>
                        <td class="px-6 py-4 whitespace-nowrap">
                            <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-green-100 text-green-800">Sécurisé</span>
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                            <a href="#" class="text-primary hover:text-indigo-900 mr-3">Détails</a>
                            <button class="text-gray-500 hover:text-primary" title="Télécharger le certificat PDF">
                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path></svg>
                            </button>
                        </td>
                    </tr>
                    <tr class="hover:bg-gray-50 transition">
                        <td class="px-6 py-4 whitespace-nowrap">
                            <div class="flex items-center">
                                <svg class="flex-shrink-0 h-6 w-6 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                                <span class="ml-4 text-sm font-medium text-gray-900">logo_design_proof.png</span>
                            </div>
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">20 Déc 2025, 09:12</td>
                        <td class="px-6 py-4 whitespace-nowrap">
                            <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-green-100 text-green-800">Sécurisé</span>
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                            <a href="#" class="text-primary hover:text-indigo-900 mr-3">Détails</a>
                            <button class="text-gray-500 hover:text-primary">
                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path></svg>
                            </button>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>

    </section>

</main>
