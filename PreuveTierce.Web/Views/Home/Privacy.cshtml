@{

    ViewData["Title"] = "Politique de Confidentialité";

}


<div class="max-w-4xl mx-auto mt-10 p-6">
    <div class="text-center mb-10">
        <h1 class="text-3xl font-bold text-gray-800">@ViewData["Title"]</h1>
        <p class="text-gray-500 mt-2">Dernière mise à jour : @DateTime.Now.ToString("dd MMMM yyyy", new System.Globalization.CultureInfo("fr-FR"))</p>
    </div>

    <div class="space-y-8">
        <section class="bg-blue-50 p-6 rounded">
            <h2 class="text-xl font-semibold text-blue-800 mb-3 flex items-center gap-2">
                <i class="bi bi-shield-check"></i> Notre Engagement
            </h2>
            <p class="text-blue-900/80">
                Chez <strong>PreuveTierce</strong>, la protection de vos données est au cœur de notre métier de tiers de confiance.
                Nous appliquons le principe de minimisation : nous ne collectons que ce qui est strictement nécessaire.
            </p>
        </section>

        <section>
            <h2 class="text-xl font-semibold text-gray-800 mb-4 flex items-center gap-2">
                <i class="bi bi-collection"></i> Quelles données collectons-nous ?
            </h2>
            <div class="grid md:grid-cols-2 gap-4">
                <div class="border  border-gray-200 rounded p-4 bg-white shadow-sm">
                    <h3 class="font-medium text-gray-700">Données de compte</h3>
                    <p class="text-sm text-gray-500 mt-1">Email, nom d'utilisateur et hachage sécurisé de votre mot de passe.</p>
                </div>
                <div class="border rounded  border-gray-200 p-4 bg-white shadow-sm">
                    <h3 class="font-medium text-gray-700">Preuves numériques</h3>
                    <p class="text-sm text-gray-500 mt-1">Les empreintes (hashes) des documents que vous déposez, sans jamais stocker le document original lui-même.</p>
                </div>
            </div>
        </section>

        <section class="border-t pt-8">
            <h2 class="text-xl font-semibold text-gray-800 mb-4 flex items-center gap-2  mt-3">
                <i class="bi bi-person-lock"></i> Vos droits (RGPD)
            </h2>
            <p class="text-gray-600 mb-4">
                Conformément au Règlement Général sur la Protection des Données, vous disposez des droits suivants :
            </p>
            <ul class="grid grid-cols-1 md:grid-cols-2 gap-3 text-sm text-gray-700">
                <li class="flex items-center gap-2"><i class="bi bi-check-circle text-green-500"></i> Droit d'accès et de rectification</li>
                <li class="flex items-center gap-2"><i class="bi bi-check-circle text-green-500"></i> Droit à l'effacement (Droit à l'oubli)</li>
                <li class="flex items-center gap-2"><i class="bi bi-check-circle text-green-500"></i> Droit à la portabilité des données</li>
                <li class="flex items-center gap-2"><i class="bi bi-check-circle text-green-500"></i> Droit d'opposition</li>
            </ul>
        </section>

        <section class="bg-gray-50 p-6 rounded text-center">
            <h2 class="text-lg font-semibold text-gray-800 mb-2">Une question sur vos données ?</h2>
            <p class="text-gray-600 mb-4 text-sm">
                Notre Délégué à la Protection des Données (DPO) est à votre écoute.
            </p>
            <a href="mailto:chaker.aich@preuvetierce.com" class="inline-flex items-center gap-2 bg-white border border-gray-300 px-4 py-2 rounded-lg text-sm font-medium hover:bg-gray-100 transition">
                <i class="bi bi-envelope"></i> Contacter le DPO
            </a>
        </section>
    </div>
</div>