@using Microsoft.AspNetCore.Identity
@using PreuveTierce.Web.Data
@inject SignInManager<ApplicationUser> SignInManager

<!DOCTYPE html>
<html lang="en" class="h-full">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PreuveTierce </title>
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/PreuveTierce.Web.styles.css" asp-append-version="true" />
</head>
@{
        var isPublic = ViewContext.RouteData.Values["controller"]?.ToString() == "Home";
        var isDashboard = ViewContext.RouteData.Values["controller"]?.ToString() == "Dashboard";
}
<body class="h-full grid grid-rows-[auto_1fr_auto]">
    <header class="bg-white border-b border-gray-100 shadow-sm">
        <nav class="h-full flex items-center">
            <div class="max-w-7xl mx-auto p-4 sm:px-6 lg:px-8 w-full">
                <div class="flex justify-between items-center h-full">
                    <div class="flex-shrink-0 flex items-center cursor-pointer" onclick="showPage('home')">
                        <a class="text-2xl font-bold text-primary tracking-tight" asp-area="" asp-controller="Home" asp-action="Index">PreuveTierce<span class="text-xs align-top opacity-70">.fr</span></a>
                    </div>
                    <div class="flex items-center space-x-4">
                        <div class="hidden md:flex items-center space-x-4 navlinks-container">
                            <!-- Vérification publique -->
                            <a asp-controller="Home"
                               asp-action="Index"
                               class="relative group text-sm transition
              @(isPublic
                                               ? "text-primary text-base font-semibold"
                                               : "text-gray-700 hover:text-primary")">
                                Vérification publique
                                <span class="absolute left-0 -bottom-1 h-[2px] w-full bg-primary
                     transition-transform duration-300 origin-left
                     @(isPublic ? "scale-x-100" : "scale-x-0 group-hover:scale-x-100")">
                                </span>

                            </a>

                            <!-- Espace client -->
                            @if (SignInManager.IsSignedIn(User))
                            {
                                <a asp-controller="Dashboard"
                                asp-action="Index"
                                class="relative group text-sm transition
              @(isDashboard
                                               ? "text-primary text-base font-semibold"
                                               : "text-gray-700 hover:text-primary")">

                                    Espace client

                                    <span class="absolute left-0 -bottom-1 h-[2px] w-full bg-primary
                     transition-transform duration-300 origin-left
                     @(isDashboard ? "scale-x-100" : "scale-x-0 group-hover:scale-x-100")">
                                    </span>
                                </a>
                            }
                            <span class="h-6 w-px bg-gray-300 mx-2"></span>

                            <partial name="_LoginPartial" />

                        </div>
                        <!-- Mobile menu button -->
                        <div class="md:hidden flex items-center">
                            <button onclick="openMobileMenu()"
                                    class="md:hidden text-gray-700 text-2xl focus:outline-none">
                                ☰
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </nav>
        <!-- Mobile Menu Modal -->
        <div id="mobile-menu-modal"
             class="fixed inset-0 z-50 hidden">

            <!-- Overlay -->
            <div class="absolute inset-0 bg-black/40 backdrop-blur-sm"
                 onclick="closeMobileMenu()"></div>

            <!-- Panel -->
            <div class="relative ml-auto h-full w-72 bg-white shadow-xl
                flex flex-col p-6 space-y-6
                animate-slide-in">

                <!-- Header -->
                <div class="flex items-center justify-between">
                    <span class="text-lg font-semibold text-primary">
                        Menu
                    </span>
                    <button onclick="closeMobileMenu()"
                            class="cursor-pointer text-2xl text-gray-600 hover:text-primary">
                        ✕
                    </button>
                </div>

                <!-- Links -->
                <nav class="flex flex-col space-y-4 text-sm font-medium">

                    <a asp-controller="Home"
                       asp-action="Index"
                       onclick="closeMobileMenu()"
                       class="relative group text-sm transition
              @(isPublic
                                                                      ? "text-primary text-base font-semibold"
                                                                      : "text-gray-700 hover:text-primary")">
                        Vérification publique
                    </a>
                      @if (SignInManager.IsSignedIn(User))
                    {
                        <a asp-controller="Dashboard"
                        asp-action="Index"
                        onclick="closeMobileMenu()"
                        class="relative group text-sm transition
              @(isDashboard
                                                                      ? "text-primary text-base font-semibold"
                                                                      : "text-gray-700 hover:text-primary")">
                            Espace client
                        </a>
                    }
                    <div class="border-t pt-4">
                        <partial name="_LoginPartial" />
                    </div>

                </nav>
            </div>
        </div>

    </header>
    <main role="main" class="container mx-auto bg-soft overflow-y-auto">
        <div class="max-w-7xl mx-auto px-4">
            <partial name="_Notifications" />
            @RenderBody()
        </div>
    </main>

    <footer class="bg-white shadow-sm border-t border-gray-100 sticky flex items-center">
        <div class="max-w-7xl mx-auto px-4 py-4 text-center text-gray-600 text-sm">
            &copy; 2026 - PreuveTierce -
            <a asp-area="" asp-controller="Home" asp-action="Privacy" class="text-primary hover:underline">Privacy</a>
        </div>
    </footer>
    <script>
          function openMobileMenu() {
            document.getElementById('mobile-menu-modal')
                .classList.remove('hidden');
            document.body.classList.add('overflow-hidden');
        }

        function closeMobileMenu() {
            document.getElementById('mobile-menu-modal')
                .classList.add('hidden');
            document.body.classList.remove('overflow-hidden');
        }
    </script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
