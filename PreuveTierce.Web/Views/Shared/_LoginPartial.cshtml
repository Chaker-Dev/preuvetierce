@using Microsoft.AspNetCore.Identity
@using PreuveTierce.Web.Data

@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@{
    var isAdmin = ViewContext.RouteData.Values["area"]?.ToString() == "Identity";
}
<div class="flex items-center gap-4 text-sm">
    @if (SignInManager.IsSignedIn(User))
    {

        <a asp-area="Identity"
           asp-page="/Account/Manage/Index"
           class="relative group text-sm transition
                      @(isAdmin? "text-primary text-base font-semibold"
                               : "text-gray-700 hover:text-primary")">
            Administration
            <span class="absolute left-0 -bottom-1 h-[2px] w-full bg-primary
                         transition-transform duration-300 origin-left
                         @(isAdmin ? "scale-x-100" : "scale-x-0 group-hover:scale-x-100")">
            </span>
        </a>

        <form asp-area="Identity"
              asp-page="/Account/Logout"
              asp-route-returnUrl="@Url.Action("Index", "Home")"
              method="post">
            <button type="submit"
                    class="bg-primary text-white px-4 py-2 rounded-md shadow-sm hover:bg-opacity-90 transition">
                Déconnexion
            </button>
        </form>
    }
    else
    {
        <!-- Visiteur -->
        <a asp-area="Identity"
           asp-page="/Account/Login"
           class="text-primary font-medium hover:underline transition">
            Connexion
        </a>

        <a asp-area="Identity"
           asp-page="/Account/Register"
           class="bg-primary text-white px-4 py-2 rounded-md shadow-sm hover:bg-opacity-90 transition">
            Créer un compte
        </a>
    }
</div>
