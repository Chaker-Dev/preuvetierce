{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=preuvenum.db"
  },
  "Tsa": {
    "Url": "https://timestamp.digicert.com",
    "Username": "",
    "Password": ""
  },
  "EmailSettings": {
    "Server": "email-smtp.eu-west-1.amazonaws.com",
    "Port": 587,
    "SenderName": "PreuveTierce",
    "SenderEmail": "no-reply@preuvetierce.fr",
    "Username": "",
    "Password": ""
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Seq" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Seq",
        "Args": { "serverUrl": "http://localhost:5341" }
      },
      { "Name": "Console" }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
